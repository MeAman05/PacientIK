    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>81ad2b35-0cd7-4d69-8602-ec46ec1f1742</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
