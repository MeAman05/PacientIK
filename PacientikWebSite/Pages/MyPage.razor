@page "/mypage"
@using PacientikWebSite.Models;
@using PacientikWebSite.Services;
@using System.Security.Claims:
@inject UserService userService
@inject AuthState state
@inject NavigationManager nav
@inject IJSRuntime js
<h3>MyPage</h3>


<div class="min-h-screen bg-[#f6f7f9] py-8 px-4">
    <div class="max-w-4xl mx-auto">

        @if (isloading)
        {
            <div class="bg-white rounded-[24px] p-8 shadow-sm animate-pulse">
                <div class="flex gap-6">
                    <div class="w-28 h-28 bg-gray-200 rounded-full"></div>
                    <div class="flex-1 space-y-4">
                        <div class="h-6 bg-gray-200 rounded w-1/3"></div>
                        <div class="h-4 bg-gray-200 rounded w-1/2"></div>
                    </div>
                </div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(error) && error != " ")
        {
            <div class="bg-red-50 border border-red-200 text-red-700 rounded-2xl p-4 flex items-center gap-3">
                <span class="text-xl">⚠️</span>
                <div>
                    <p class="font-semibold">Ошибка загрузки</p>
                    <p class="text-sm opacity-80">@error</p>
                </div>
                <button @onclick="GetPage" class="ml-auto bg-red-600 text-white px-4 py-2 rounded-xl text-sm hover:bg-red-700">Повторить</button>
            </div>
        }
        else
        {
            <!-- Header Card -->
            <div class="bg-white rounded-[28px] shadow-sm border border-gray-100 overflow-hidden">
                <!-- Cover -->
                <div class="h-32 bg-gradient-to-r from-violet-500 via-indigo-500 to-blue-500"></div>

                <div class="px-8 pb-8">
                    <div class="flex flex-col md:flex-row gap-6 -mt-14">
                        <!-- Avatar -->
                        <div class="relative">
                            <img src="@model.photourl"
                                 class="w-28 h-28 rounded-[24px] object-cover border-4 border-white shadow-lg bg-white" />
                            <div class="absolute -bottom-1 -right-1 w-6 h-6 bg-green-500 border-4 border-white rounded-full"></div>
                        </div>

                        <!-- Info -->
                        <div class="flex-1 pt-4 md:pt-16">
                            <div class="flex flex-wrap items-start justify-between gap-4">
                                <div>
                                    <h1 class="text-[28px] font-bold tracking-tight text-gray-900 leading-none">@model.name</h1>
                                    <h1 class="text-[28px] font-bold tracking-tight text-gray-900 leading-none">@model.surname</h1>
                                    <h1 class="text-[28px] font-bold tracking-tight text-gray-900 leading-none">@model.lastname</h1>
                                </div>
                                <div class="flex gap-2">
                                    <a href="/edit/@id" class="px-5 py-2.5 bg-gray-900 text-white rounded-full text-sm font-medium hover:bg-black transition">
                                        Редактировать
                                    </a>
                                    <button class="px-5 py-2.5 bg-white border border-gray-200 rounded-full text-sm font-medium hover:bg-gray-50 transition">
                                        Поделиться
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


@code {
    string error = "";
    bool isloading = false;
    UserModel model = new UserModel();
    Guid id = new Guid();
    protected override async Task OnInitializedAsync()
    {
        await GetPage();
    }

    async Task GetPage()
    {
        var authState = await state.GetAuthenticationStateAsync();
        var user = authState.User;
        var myid = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (myid == null)
        {
            nav.NavigateTo("/loginpage");
            return;
        }

        id = Guid.Parse(myid);
        try
        {
            isloading = true;
            model = await userService.GetUserById(id);
        }
        catch(Exception ex)
        {
            error = $"{ex.Message}";
        }
        finally
        {
            isloading = false;
        }
    }
}
