@page "/report/{id:int}"
@using PacientikWebSite.Services;
@using PacientikWebSite.Models.ReportModels;
@inject ReportService service

@if (isloading)
{
    <p>Загрузка...</p>
}
else
{
    <div class="p-4">
        <a href="/myreports" class="text-decoration-none">← Назад</a>

        <h4 class="mt-3 fw-bold">@model.pacientname</h4>

        <div class="mt-4 d-flex flex-column gap-3" style="max-width:500px">

            <div class="d-flex justify-content-between border-bottom pb-2">
                <span class="text-muted">Врач:</span>
                <span class="fw-semibold">@model.sender</span>
            </div>

            <div class="d-flex justify-content-between border-bottom pb-2">
                <span class="text-muted">Лечение:</span>
                @foreach(var lchs in model.leches)
                {
                    <span class="fw-semibold">@lchs</span>
                }
                
            </div>

            <div class="d-flex justify-content-between border-bottom pb-2">
                <span class="text-muted">Период:</span>
                <span class="fw-semibold">@model.period дней</span>
            </div>

            <div class="d-flex justify-content-between pt-2">
                <span class="text-muted">Цена:</span>
                <span class="fw-bold fs-5 text-success">@model.price сом</span>
            </div>

        </div>
    </div>
}

@code {
    [Parameter] public int id { get; set; }
    ReportModel model = new();
    bool isloading = false;
    protected override async Task OnInitializedAsync()
    {
        await GetReport();
    }

    async Task GetReport()
    {
        try
        {
            isloading = true;
            model = await service.GetReportById(id);
        }
        catch(Exception ex)
        {
            Console.WriteLine(ex.Message);
            return;
        }
        finally
        {
            isloading = false;
        }
    }

    async Task ChangeReport()
    {
        
    }
}
