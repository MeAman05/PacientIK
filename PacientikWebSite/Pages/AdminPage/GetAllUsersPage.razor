@page "/getallusers"
@using PacientikWebSite.Services;
@using PacientikWebSite.Models;
@inject UserService userService

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="search-container">
                <input type="text" class="form-control search-input" placeholder="Search..." @bind="text" @bind:event="oninput" @onkeyup="EnterKey">
                <i class="fas fa-search search-icon" @onclick="GetAllUsers"></i>
            </div>
        </div>
    </div>
</div>

@if (isloading)
{
    <a>загрузка..</a>
}

else
{
    <table class="table">
        <thead class="thead-dark">
            <tr>
                <th scope="col">#</th>
                <th scope="col">Имя</th>
                <th scope="col">Фамилия</th>
                <th scope="col">Возраст</th>
                <th scope="col">Роль</th>
                <th scope="col">Специалист</th>
                <th scope="col">ID</th>
                <th scope="col">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var model in models)
            {
                <tr @key="model.userid">
                    <th scope="row">@(models.IndexOf(model) + 1)</th>
                    <td>@model.name</td>
                    <td>@model.surname</td>
                    <td>@model.age</td>
                    <td>@model.role</td>
                    <td>@model.spec</td>
                    <td>@model.userid</td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a href="/edit/@model.userid" class="btn btn-warning @(isdeleteing ? "disabled" : "")">Изменить</a>
                            <a href="/userbyid/@model.userid" class="btn btn-warning @(isdeleteing ? "disabled" : "")">Посмотреть</a>
                            <button class="btn btn-danger" @onclick="() => DeleteUser(model.userid)" disabled="@isdeleteing">
                                @if (isdeleteing)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <span>Удалить</span>
                                }
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    string text = "";
    string error = "";
    List<UserModel> models = new();
    bool isloading = false;
    bool isdeleteing = false;

    protected override async Task OnInitializedAsync()
    {
        await GetAllUsers();
    }
    async Task GetAllUsers()
    {
        try
        {
            isloading = true;
            models = await userService.GetAllUsers(text);
        }
        catch(Exception ex)
        {
            error = $"{ex.Message}";
        }
        finally
        {
            isloading = false;
        }
    }

    async Task EnterKey(KeyboardEventArgs key)
    {
        if(key.Key == "Enter")
        {
            await GetAllUsers();
        }
    }

    async Task DeleteUser(Guid id)
    {
        try
        {
            isdeleteing = true;
            models.RemoveAll(r => r.userid == id);
            await userService.DeleteUser(id);
           
        }
        catch(Exception ex)
        {
            Console.WriteLine(ex.Message);
            return;
        }
        finally
        {
            isdeleteing = false;
        }
    }
}
