<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	 <StaticWebAssetsFingerprintingEnabled>false</StaticWebAssetsFingerprintingEnabled>
	 <PublishWithStaticWebAssetsFingerprintingEnabled>false</PublishWithStaticWebAssetsFingerprintingEnabled>
	 <StaticWebAssetsCompressionEnabled>false</StaticWebAssetsCompressionEnabled>
	 <PublishWithStaticWebAssetsCompressionEnabled>false</PublishWithStaticWebAssetsCompressionEnabled>
	 <PublishWithStaticWebAssetsIntegrityCheckEnabled>false</PublishWithStaticWebAssetsIntegrityCheckEnabled>
	 <UseBlazorIntegrityCheck>false</UseBlazorIntegrityCheck>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.10" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Features" Version="5.0.17" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="MudBlazor" Version="9.8.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.1" />
  </ItemGroup>

</Project>
