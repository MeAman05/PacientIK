@page "/mypage/{Id:guid}"
@using Pacientikapplication.Services;
@using Pacientikapplication.Models.UserSer;
@inject UserService userService
@inject NavigationManager nav
@using Pacientikapplication.Models;
@inject BaseAdress adress
<h3>MyyPage</h3>
<div class="container py-5">
    @if (isloading)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 60vh;">
            <div class="text-center">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
                <p class="mt-3 text-muted">Загрузка профиля...</p>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error) && error != " ")
    {
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="alert alert-danger shadow-sm">@error</div>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-header bg-primary bg-gradient p-0 border-0" style="height: 140px;"></div>

                    <div class="card-body p-4 p-md-5">
                        <!-- ФОТКА -->
                        <div class="d-flex flex-column flex-md-row align-items-md-end" style="margin-top: -90px;">
                            <div class="position-relative">
                                <div class="bg-white rounded-circle p-1 shadow">
                                    @if (!string.IsNullOrEmpty(model.photourl))
                                    {
                                        <img src="@($"{BaseAdress.adres}{model.photourl}")" class="rounded-circle object-fit-cover" style="width: 120px; height: 120px;" />
                                    }
                                    else if (!string.IsNullOrEmpty(model.photourl))
                                    {
                                        
                                    }
                                    else
                                    {
                                        <div class="bg-secondary-subtle rounded-circle d-flex justify-content-center align-items-center" style="width: 120px; height: 120px;">
                                            <span class="fs-1 fw-bold text-secondary">@(model.name?.FirstOrDefault().ToString().ToUpper() ?? "U")</span>
                                        </div>
                                    }
                                </div>
                                
                            </div>

                            <div class="ms-md-4 mt-3 flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h4 class="fw-bold mb-1">@model.name @model.surename</h4>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr class="my-4">

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small text-uppercase fw-bold">Имя</label>
                                <input class="form-control bg-light border-0 rounded-3" value="@model.name" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small text-uppercase fw-bold">Фамилия</label>
                                <input class="form-control bg-light border-0 rounded-3" value="@model.surename" readonly />
                            </div>
                            <div class="col-12">
                                <label class="form-label text-muted small text-uppercase fw-bold">Email</label>
                                <input class="form-control bg-light border-0 rounded-3" value="@model.lastname" readonly />
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-5">
                            <button class="btn btn-primary px-4 rounded-3" @onclick='() => nav.NavigateTo($"/edituser/{Id}")'>
                                <i class="bi bi-pencil-square me-1"></i> Редактировать профиль
                            </button>
                            <button class="btn btn-light border px-4 rounded-3" @onclick='() => nav.NavigateTo("/")'>На главную</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


@code {
    [Parameter] public Guid Id { get; set; }

    Guid myid = new Guid();

    string error = " ";
    bool isloading = false;
    UserModel model = new UserModel();
    string adr = " ";

    protected override async Task OnInitializedAsync()
    {
        var uid =  await SecureStorage.GetAsync("uid");
        myid = Guid.Parse(uid);
        await Check(myid);
        await GetUuserById();
    }

    async Task Check(Guid muid)
    {
        var token = await SecureStorage.GetAsync("token");
        var role = await SecureStorage.GetAsync("role");
        if(muid != Id || role != "Admin" || role != "Checker")
        {
            switch (role)
            {
                case "User":
                    nav.NavigateTo("/userpage");
                    break;

                case "Checker":
                    nav.NavigateTo("/checkerpage");
                    break;
            }
        }
        if (token == null)
        {
            nav.NavigateTo("/loginn");
        }
    }

    async Task GetUuserById()
    {
        try
        {
            isloading = true;
            var result = await userService.GetUserById(Id);
            model = result;
        }
        catch
        {
            error = "Error";
        }
        finally
        {
            isloading = false;
        }

       
    }
}
